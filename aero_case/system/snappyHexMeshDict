/*--------------------------------*- C++ -*----------------------------------*\
  AeroScan rider+bike case  (OpenFOAM ESI v2312+, openfoam.com)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    rider.stl       { type triSurfaceMesh; name rider; }
    bike.stl        { type triSurfaceMesh; name bike; }
    wheel_rear.stl  { type triSurfaceMesh; name wheel_rear; }
    wheel_front.stl { type triSurfaceMesh; name wheel_front; }
    nearBox { type searchableBox; min (-1.2 -0.5 0); max (1.6 0.5 1.6); }
    wakeBox { type searchableBox; min (-1.5 -0.8 0); max (4.5 0.8 2.0); }
}

castellatedMeshControls
{
    maxLocalCells 2000000;
    maxGlobalCells 40000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 3;
    features
    (
        { file "rider.eMesh";       level 6; }
        { file "bike.eMesh";        level 6; }
        { file "wheel_rear.eMesh";  level 6; }
        { file "wheel_front.eMesh"; level 6; }
    );
    refinementSurfaces
    {
        rider       { level (5 6); patchInfo { type wall; } }
        bike        { level (5 6); patchInfo { type wall; } }
        wheel_rear  { level (5 6); patchInfo { type wall; } }
        wheel_front { level (5 6); patchInfo { type wall; } }
    }
    resolveFeatureAngle 30;
    refinementRegions
    {
        nearBox { mode inside; levels ((1E15 4)); }   // 15.6 mm
        wakeBox { mode inside; levels ((1E15 3)); }   // 31 mm
    }
    locationInMesh (-3.13 1.71 2.37);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 50;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;
    layers
    {
        "(rider|bike|wheel_rear|wheel_front)" { nSurfaceLayers 3; }
    }
    expansionRatio 1.2;
    finalLayerThickness 0.4;
    minThickness 0.1;
    nGrow 0;
    featureAngle 130;
    slipFeatureAngle 30;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    #includeEtc "caseDicts/meshQualityDict"
    nSmoothScale 4;
    errorReduction 0.75;
}

mergeTolerance 1e-6;
