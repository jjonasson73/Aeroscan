/*--------------------------------*- C++ -*----------------------------------*\
  AeroScan rider+bike case  (OpenFOAM ESI v2312+, openfoam.com)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Domain [m]; rider faces -x, flow along +x. Bike spans x -0.74..0.92, z 0..1.37
xmin -4; xmax 10; ymin -2.5; ymax 2.5; zmin 0; zmax 3.5;
vertices
(
    ($xmin $ymin $zmin) ($xmax $ymin $zmin) ($xmax $ymax $zmin) ($xmin $ymax $zmin)
    ($xmin $ymin $zmax) ($xmax $ymin $zmax) ($xmax $ymax $zmax) ($xmin $ymax $zmax)
);
blocks ( hex (0 1 2 3 4 5 6 7) (56 20 14) simpleGrading (1 1 1) );   // 0.25 m base cells
boundary
(
    inlet   { type patch; faces ((0 4 7 3)); }
    outlet  { type patch; faces ((1 2 6 5)); }
    ground  { type wall;  faces ((0 3 2 1)); }
    top     { type symmetryPlane; faces ((4 5 6 7)); }
    // BÅDA sidorna ligger i samma patch, och symmetryPlane kräver att hela patchen är ETT
    // plan: normalerna (0 -1 0) och (0 1 0) medelvärdesbildas till (0 0 0) och blockMesh
    // avbryter. 'symmetry' är den allmänna varianten som klarar flera plan i samma patch.
    sides   { type symmetry; faces ((0 1 5 4) (3 7 6 2)); }
);
