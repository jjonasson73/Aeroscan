/*--------------------------------*- C++ -*----------------------------------*\
  AeroScan rider+bike case  (OpenFOAM ESI v2312+, openfoam.com)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
    }
    Phi { $p; }
    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
        nSweeps         1;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      yes;
    residualControl { p 1e-4; U 1e-5; "(k|omega)" 1e-5; }
}
potentialFlow { nNonOrthogonalCorrectors 10; }
relaxationFactors
{
    equations { U 0.9; ".*" 0.7; }
}
