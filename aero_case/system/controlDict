/*--------------------------------*- C++ -*----------------------------------*\
  AeroScan rider+bike case  (OpenFOAM ESI v2312+, openfoam.com)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         2000;
deltaT          1;
writeControl    timeStep;
writeInterval   500;
purgeWrite      2;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

// NOTE: Aref = 1  ->  the reported "Cd" IS CdA [m^2] directly.
// Projected frontal area of the model (for reference): 0.3614 m^2
forceDefaults
{
    type            forceCoeffs;
    libs            (forces);
    writeControl    timeStep;
    writeInterval   1;
    log             true;
    rho             rhoInf;
    rhoInf          1.20;
    CofR            (0 0 0);
    liftDir         (0 0 1);
    dragDir         (1 0 0);
    pitchAxis       (0 1 0);
    magUInf         12.5;
    lRef            1.0;
    Aref            1.0;
}

functions
{
    CdA_total  { $forceDefaults; patches (rider bike wheel_rear wheel_front); }
    CdA_rider  { $forceDefaults; patches (rider); }
    CdA_bike   { $forceDefaults; patches (bike); }
    CdA_wheels { $forceDefaults; patches (wheel_rear wheel_front); }
    yPlus      { type yPlus; libs (fieldFunctionObjects); writeControl writeTime; }
    wallShearStress { type wallShearStress; libs (fieldFunctionObjects); writeControl writeTime; }

    // Fältdata för efterbehandling. En CdA-siffra säger att något är fel men inte var, och
    // när deltat inte är stabilt är ytfälten enda sättet att se varför. Skrivs bara vid
    // writeTime, alltså en gång i slutet - inte per iteration.
    //
    // p är kinematiskt tryck (p/rho, m^2/s^2). Cp = p / (0.5 * magUInf^2).
    // wallShearStress x-komponenten byter tecken där flödet vänder: det är separationslinjen.
    diagSurfaces
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   vtk;
        fields          (p wallShearStress);
        surfaces
        {
            s_rider       { type patch; patches (rider); }
            s_bike        { type patch; patches (bike); }
            s_wheel_rear  { type patch; patches (wheel_rear); }
            s_wheel_front { type patch; patches (wheel_front); }
        }
    }

    // Symmetrisnittet visar vaken: var trycket sjunker och var turbulensen produceras.
    diagSlice
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   vtk;
        fields          (p U k nut);
        surfaces
        {
            midplane
            {
                type            cuttingPlane;
                point           (0 0 0);
                normal          (0 1 0);
                interpolate     true;
            }
        }
    }

    // Avbryt automatiskt när CdA har stabiliserats (glidande medel ändras < 0.2 %).
    // timeStart håller villkoret vilande under det inledande transientet: utan det kan
    // medelvärdet råka ligga still runt iteration ~150 medan lösningen fortfarande
    // byggs upp, och körningen stoppas alldeles för tidigt.
    // OBS: fortfarande overifierad mot en riktig körning - kontrollera i log.simpleFoam
    // att raden "Conditions met" dyker upp, annars körs endTime-iterationerna ut.
    stopWhenConverged
    {
        type            runTimeControl;
        libs            (utilityFunctionObjects);
        timeStart       400;
        conditions
        {
            cdaStable
            {
                type            average;
                functionObject  CdA_total;
                fields          (Cd);
                tolerance       2e-3;
                window          150;
                windowType      approximate;
            }
        }
    }
}
