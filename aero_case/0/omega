/*--------------------------------*- C++ -*----------------------------------*\
  AeroScan rider+bike case  (OpenFOAM ESI v2312+, openfoam.com)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "include/initialConditions"
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform $turbOmega;
boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    inlet
    {
        type fixedValue; value uniform $turbOmega;
    }
    outlet
    {
        type inletOutlet; inletValue uniform $turbOmega; value uniform $turbOmega;
    }
    ground
    {
        type omegaWallFunction; value uniform $turbOmega;
    }
    rider
    {
        type omegaWallFunction; value uniform $turbOmega;
    }
    bike
    {
        type omegaWallFunction; value uniform $turbOmega;
    }
    wheel_rear
    {
        type omegaWallFunction; value uniform $turbOmega;
    }
    wheel_front
    {
        type omegaWallFunction; value uniform $turbOmega;
    }
}
